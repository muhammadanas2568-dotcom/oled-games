title Pixel Runner
fps 25
init
p = 16
y = 50
vy = 0
obs = 120
frame
cls
if btn && y >= 50
 vy = -8
end
y += vy
vy += 1
if y > 50
 y = 50
 vy = 0
end
obs -= 3
if obs < 0
 obs = 128
 score += 1
end
fill obs, 48, 6, 14
fill p, y, 7, 7
line 0, 62, 127, 62
if obs < p + 7 && obs + 6 > p && y > 42
 over
end
text 0, 0, "JUMP: SW"
num 94, 0, score
