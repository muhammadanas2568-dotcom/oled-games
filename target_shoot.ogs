title Target Shoot
fps 20
init
x = 60
y = 30
tx = 90
ty = 30
frame
cls
if jx < 0
 x -= 3
end
if jx > 0
 x += 3
end
if btn
 if x > tx - 6 && x < tx + 6
  if y > ty - 6 && y < ty + 6
   score += 1
   tx = rnd(110) + 8
   ty = rnd(45) + 10
  end
 end
end
if x < 3
 x = 3
end
if x > 125
 x = 125
end
disc tx, ty, 5
rect x - 3, y - 3, 7, 7
text 0, 0, "HIT TARGET"
num 105, 0, score
