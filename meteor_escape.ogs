title Meteor Escape
fps 25
init
p = 60
i = 0
while i < 4
 m[i] = rnd(120)
 m[i + 8] = 0 - rnd(50)
 i += 1
end
frame
cls
if jx < 0
 p -= 4
end
if jx > 0
 p += 4
end
if p < 0
 p = 0
end
if p > 120
 p = 120
end
i = 0
while i < 4
 m[i + 8] += 2
 if m[i + 8] > 64
  m[i + 8] = 0 - rnd(40)
  m[i] = rnd(120)
 end
 disc m[i], m[i + 8], 3
 if m[i + 8] > 52 && m[i] > p - 3 && m[i] < p + 8
  over
 end
 i += 1
end
fill p, 56, 8, 6
text 0, 0, "METEOR"
num 95, 0, score
