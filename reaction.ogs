# Reaction : รอให้ขึ้น NOW! แล้วกดให้เร็วที่สุด (กดก่อน = แพ้)
title Reaction
fps 30
init
s = 0
w = 30 + rnd(60)
r = 15
frame
cls
if s == 0
  w -= 1
  text 40, 28, "WAIT..."
  if btn
    over
  end
  if w <= 0
    s = 1
    t = 0
  end
end
if s == 1
  t += 1
  size 3
  text 20, 22, "NOW!"
  size 1
  if btn
    if t <= r
      score += 1
      s = 2
      c = 20
      if r > 6
        r -= 1
      end
    else
      over
    end
  end
  if t > 25
    over
  end
end
if s == 2
  c -= 1
  text 30, 28, "GOOD!"
  num 80, 28, t * 33
  text 104, 28, "ms"
  if c <= 0
    s = 0
    w = 30 + rnd(60)
  end
end
num 0, 0, score
