title Collect Stars
fps 25
init
p = 60
x = 30
y = 20
frame
cls
if jx < 0
 p -= 3
end
if jx > 0
 p += 3
end
if btn
 y += 6
end
if p < 0
 p = 0
end
if p > 120
 p = 120
end
disc x, y, 3
fill p, 52, 7, 7
if y > 48 && x > p - 3 && x < p + 10
 score += 1
 x = rnd(120)
 y = 0
end
y += 2
if y > 63
 y = 0
 x = rnd(120)
end
text 0, 0, "STARS"
num 90, 0, score
