title Coin Catcher
fps 25
init
p = 60
x = 30
y = 15
frame
cls
if jx < 0
 p -= 3
end
if jx > 0
 p += 3
end
if p < 0
 p = 0
end
if p > 120
 p = 120
end
y += 2
if y > 60
 y = 0
 x = rnd(120)
end
disc x, y, 3
fill p, 56, 8, 5
if y > 52 && x > p - 3 && x < p + 10
 score += 1
 y = 0
 x = rnd(120)
end
text 0, 0, "CATCH"
num 90, 0, score
