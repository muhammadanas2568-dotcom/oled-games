title Space Shooter
fps 25
init
p = 60
bx = 0
by = 0
active = 0
i = 0
while i < 3
 m[i] = rnd(120)
 m[i + 8] = 0 - rnd(64)
 i += 1
end
frame
cls
if jx < 0
 p -= 3
end
if jx > 0
 p += 3
end
if p < 0
 p = 0
end
if p > 120
 p = 120
end
if btn
 bx = p + 3
 by = 49
 active = 1
end
if active
 by -= 5
 line bx, by, bx, by + 5
 if by < 0
  active = 0
 end
end
i = 0
while i < 3
 m[i + 8] += 1
 if m[i + 8] > 62
  m[i + 8] = 0 - rnd(30)
  m[i] = rnd(120)
 end
 fill m[i], m[i + 8], 5, 5
 if active && bx > m[i] - 2 && bx < m[i] + 7 && by > m[i + 8] - 3 && by < m[i + 8] + 7
  score += 1
  m[i + 8] = 0 - rnd(30)
  m[i] = rnd(120)
  active = 0
 end
 i += 1
end
fill p, 55, 7, 7
text 0, 0, "FIRE: SW"
num 94, 0, score
